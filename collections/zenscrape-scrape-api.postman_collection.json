      "item": [
        {
          "id": "6fd28648-98d8-4b8e-b125-71969bf99ea1",
          "name": "Scrape a target URL and return its HTML.",
          "request": {
            "name": "Scrape a target URL and return its HTML.",
            "description": {
              "content": "Fetches the target URL through a rotating proxy pool and returns the page source. Set `render=true` to execute the page's JavaScript with a headless browser, and `premium=true` to route through premium residential proxies. Cost: 1 credit (no render, no premium), 5 (render), 10 (premium), 25 (premium + render).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "get"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "url",
                  "value": "<uri>",
                  "description": "(Required) The fully qualified URL of the page to scrape."
                },
                {
                  "disabled": false,
                  "key": "render",
                  "value": "false",
                  "description": "Render the page with a headless browser, executing client-side JavaScript before returning the resulting HTML."
                },
                {
                  "disabled": false,
                  "key": "premium",
                  "value": "false",
                  "description": "Route the request through premium residential proxies to reduce the chance of bot detection."
                },
                {
                  "disabled": false,
                  "key": "location",
                  "value": "<string>",
                  "description": "Two-letter country code identifying the geolocation the request should originate from (e.g. `us`, `de`, `au`). Premium locations require the premium parameter."
                },
                {
                  "disabled": false,
                  "key": "device",
                  "value": "desktop",
                  "description": "Device type to emulate for the request."
                },
                {
                  "disabled": false,
                  "key": "keep_headers",
                  "value": "false",
                  "description": "Forward the headers sent on the request to the target site. Combine with custom request headers to control the scraped response."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/html"
              }
            ],
            "method": "GET",
            "auth": null
          },
